{
  "manifest_version": 3,
  "name": "WorthProof 见值",
  "version": "0.4.3",
  "description": "将当前商品页的可见价格和规格发送到 WorthProof，先确认再比较。",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:8200/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8200/*",
    "http://localhost:8000/*",
    "https://worthproof.com/*",
    "https://www.worthproof.com/*",
    "https://api.worthproof.com/*",
    "https://worthproof-api.vercel.app/*",
    "https://*.jd.com/*",
    "https://*.taobao.com/*",
    "https://*.tmall.com/*",
    "https://*.pinduoduo.com/*",
    "https://*.yangkeduo.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "采集当前商品到 WorthProof",
    "default_popup": "popup.html",
    "default_icon": { "128": "icons/icon128.png" }
  },
  "icons": { "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://*.jd.com/*", "https://*.taobao.com/*", "https://*.tmall.com/*", "https://*.pinduoduo.com/*", "https://*.yangkeduo.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
